{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr review:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "WebSearch",
      "Bash(cargo check:*)",
      "Bash(uv build:*)",
      "Bash(rustup toolchain:*)",
      "Bash(rustup default:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(git push:*)",
      "Bash(wait)",
      "Bash(cargo run:*)",
      "Bash(cargo clippy *)",
      "Bash(uv pip *)",
      "Bash(cargo doc *)",
      "Bash(./scripts/build.sh data_manager_core *)",
      "Write(/home/kiyama/.claude/homunculus/instincts/personal/*.yaml)",
      "Write(/home/kiyama/.claude/homunculus/instincts/personal/*.md)",
      "Write(/home/kiyama/.claude/homunculus/projects/**/instincts/personal/*.yaml)",
      "Write(/home/kiyama/.claude/homunculus/projects/**/instincts/personal/*.md)",
      "Edit(/home/kiyama/.claude/homunculus/instincts/personal/*.yaml)",
      "Edit(/home/kiyama/.claude/homunculus/instincts/personal/*.md)",
      "Edit(/home/kiyama/.claude/homunculus/projects/**/instincts/personal/*.yaml)",
      "Edit(/home/kiyama/.claude/homunculus/projects/**/instincts/personal/*.md)",
      "Read(/home/kiyama/.claude/homunculus/**)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/kiyama/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/home/kiyama/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": true,
  "preferredNotifChannel": "kitty",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "disabledMcpJsonServers": [
    "cloudflare-docs",
    "cloudflare-workers-builds",
    "cloudflare-workers-bindings",
    "cloudflare-observability",
    "clickhouse",
    "firecrawl",
    "magic",
    "railway",
    "PayPal",
    "Stripe",
    "supabase",
    "vercel"
  ]
}

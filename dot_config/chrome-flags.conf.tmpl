# Read by /usr/bin/google-chrome-stable wrapper (one flag per line, '#' comments).
# ~/.cache and /var are on HDD; keep the disk cache on NVMe (/tmp is on `/`)
# to avoid IO stalls (see docs/issues/2026-10-31-chrome-freeze-hdd-io.md).
--disk-cache-dir=/tmp/chrome-cache-{{ .chezmoi.username }}

# Hardware video decode (incl. AV1) via libva-nvidia-driver (NVDEC).
# Requires LIBVA_DRIVER_NAME=nvidia (set in hypr/custom/environment.lua).
# Source: nvidia-vaapi-driver README (Chrome section). EXPERIMENTAL: revert
# these lines if Chrome becomes unstable / video turns green.
--enable-features=AcceleratedVideoDecodeLinuxGL,VaapiOnNvidiaGPUs
--ignore-gpu-blocklist
--use-gl=angle
--use-angle=gl

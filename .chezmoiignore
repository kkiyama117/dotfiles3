# It's base is root directory that dotfiles are applied
# for example: `~/.zshenv` -> `.zshenv`
# And some files that exists in this repository must be
# included in the ignore list to avoid conjection with
# the actual dotfiles

# ============================================================
# Repository metadata and programs itself
# ============================================================
container
dependencies
docs
programs
tests
.env.example
AGENTS.md
Makefile
README.md

# Container-related files
.containerignore

# Chezmoi-related files
## It may be exposed by default
.chezmoiignore
.chezmoidata.yaml
.chezmoidata/*.yaml

# Git-related files
**/.git/
**/.git/**
**/.gitignore
**/.gitmodules
**/.worktrees

# ============================================================
# Bind mounts in the container
# ============================================================

# Toolchain / keyring volume mountpoints
## never managed by chezmoi

# Cargo: chezmoi manages ONLY ~/.local/share/cargo/config.toml. Everything
# else under $CARGO_HOME (bin, registry, git cache) is volume-owned.
.local/share/cargo/*
!.local/share/cargo/config.toml
!.local/share/cargo/binstall.toml

.local/share/rustup
.local/share/mise
.local/share/gnupg

# Golang: `~/.config/go` is not managed now and may include local data
.config/go/*
!.config/go/.keep

# Herdr: log of herdr isn't needed to manage
.config/herdr/*
!.config/herdr/config.toml
!.config/herdr/config.yml

# SSH: chezmoi manages ONLY ~/.ssh/config. Everything else under ~/.ssh/
# (private/public keys, known_hosts, config.d/*) is volume-owned and must
# never be touched by chezmoi. Exclude the whole tree, then re-include config.
.ssh/*
!.ssh/config

# ZSH: compinit generates `.zcompdump` to cache the latest zsh complations.
# So we unmanage it in chezmoi.
.config/zsh/.zcompdump*
.config/zsh/.zcompcache
.config/zsh/.zshenv

# Self bind-mount target (chezmoi source root)
.local/share/chezmoi

# ============================================================
# User generated files for dotfiles
# ============================================================
.env

# ============================================================
# Legacy / superseded configs (kept in $HOME but never managed)
# ============================================================

# Legacy terminals / input methods (replaced by kitty / fcitx5+skk)
.config/wezterm
.config/mozc
.config/yaskkserv2
.config/systemd/user/yaskkserv2.service

# tmux: host-local config, intentionally not managed
.config/tmux

# Syncthing: runtime state lives under ~/.local/state/syncthing
.config/syncthing

# Claude Code: only settings.json + CLAUDE.md are managed; the rest is runtime state
.config/claude/*
!.config/claude/settings.json
!.config/claude/CLAUDE.md

# Chezmoi's own config/state (machine-local)
.config/chezmoi

# Backups / superseded files
.config/npm
.config/pki

# nvim secrets: superseded by env-based secrets (api_secrets.yaml)
.config/nvim/rc/secrets.vim

# Tool binaries / local data
.local/bin/hermes-fusion
.local/share/zsh

# ============================================================
# AI-related files
# ============================================================
.agents
.claude
{{ if not (eq .runtime "container") }}.pi{{ end }}
.superpowers

